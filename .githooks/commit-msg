#!/usr/bin/env sh
# Refuse AI authorship credit before a commit is written.
#
# The rules live in tools/commit-msg (Rust). Install once per clone from the
# reviewed default branch, at the repository root, with no local edits (the
# first line refuses otherwise):
#
#     git fetch origin && git diff --quiet HEAD && git merge-base --is-ancestor HEAD origin/main &&
#     hooks="$(git rev-parse --git-common-dir)/hooks" &&
#     COMMIT_MSG_GUARD_SOURCE="$(git rev-parse HEAD)" cargo install --locked --quiet \
#         --path tools/commit-msg --root "$hooks/commit-msg-guard" &&
#     cp .githooks/commit-msg "$hooks/commit-msg" && chmod +x "$hooks/commit-msg"
#
# (--git-common-dir also works in a linked worktree, where .git is a file. Do
# not use --git-path hooks: it resolves to core.hooksPath when one is set.)
# Rerun both steps from the default branch after reviewing a change to either;
# `"$hooks/commit-msg-guard/bin/commit-msg-guard" --version` names the commit
# the installed copy was built from, and the guard warns when the rules on
# origin/HEAD differ from it.
#
# This file runs only the binary installed beside it, never anything from the
# working tree, so checking out a contributor's branch and committing runs no
# code from that branch. Never set core.hooksPath to .githooks: Git would then
# run every hook name (post-checkout, pre-commit and so on) from whichever
# branch is checked out. An absolute hooks directory you control outside the
# clone is fine. Earlier copies of this header said to set it: check with
# `git config --show-origin --get-all core.hooksPath` and, if it names
# .githooks, run `git config --unset core.hooksPath` (add --global or
# --worktree when the origin is that file), then check again before checking
# out any other branch.
#
# tools/commit-msg is a local copy of the message and identity rules in the
# shared `No AI attribution` policy (ryanduguid/release-policy, the composite
# action .github/actions/no-ai-attribution/action.yml). It exists so a commit
# fails at the keyboard rather than after a push, so the two must agree; its
# source says how.

set -eu

guard="$(dirname "$0")/commit-msg-guard/bin/commit-msg-guard"
if [ ! -x "$guard" ] && [ ! -x "$guard.exe" ]; then
	printf 'commit-msg: %s is missing or not executable; cannot check attribution.\n' "$guard" >&2
	printf 'Install it as the header of .githooks/commit-msg says, or skip with --no-verify and expect CI to reject it.\n' >&2
	exit 1
fi
exec "$guard" "$1"
